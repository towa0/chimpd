{
  "name": "chimpd",
  "version": "0.1.0",
  "description": "Measures whether a TypeScript project's tests catch bugs in the code a branch changed, and whether the outgoing calls that code makes survive a server that never answers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "chimpd": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p fixtures/sample-app",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:compat": "npm run compat:install && vitest run --config vitest.compat.config.ts",
    "compat:install": "npm install --prefix test/compat/vitest-4"
  },
  "dependencies": {
    "@mswjs/interceptors": "0.45.12",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/instrumenter": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "vitest": ">=4.1 <6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "10.14.0",
    "jsdom": "29.1.1",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
