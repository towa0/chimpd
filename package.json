{
  "name": "chimpd",
  "version": "0.1.0",
  "description": "Measures whether a TypeScript project's tests catch bugs and whether its code survives dependency failures, scoped to what a branch changed.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:compat": "npm run compat:install && vitest run --config vitest.compat.config.ts",
    "compat:install": "npm install --prefix test/compat/vitest-4"
  },
  "dependencies": {
    "@mswjs/interceptors": "0.45.12",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "vitest": ">=4.1 <6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
